# --- Program output ---------------------------------------------------------
#
# Generated mods. Each run DELETES and rebuilds the mod's FDBs, so nothing here
# is authored by hand and none of it should be versioned. `generate_species()`
# recreates the tree with makedirs(exist_ok=True), so a fresh clone is fine
# without it.
#
# NOTE: a project's mod_project.json lives in here too. That file IS the
# reviewable description of a mod, so if you want to keep one, copy it out
# rather than un-ignoring the folder - see the note at the bottom.
Generated/

# Per-mod build scripts (vestigial - the generator no longer emits these, but
# older versions wrote build_and_install_<mod>.py here).
BuildScripts/

# Run logs written by the GUI on every run, including failed ones.
Logs/
species_gen_log.txt
*.log

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtualenvs
.venv/
venv/
env/
ENV/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Windows shell junk that lands in asset folders
desktop.ini

# --- Scratch ----------------------------------------------------------------
scratch/
tmp/
temp/
*.bak
*.orig
*.rej

# Cobra-tools writes these beside an archive it has opened.
*.ovl.bak
backups/


# --- Deliberately NOT ignored -----------------------------------------------
#
# prefab_index.json   Derived from JWE3_Prefabs.lua by prefab_index.py, but that
#                     dump lives OUTSIDE this repo, so a clone cannot rebuild
#                     it. The UI loads it on every start, so it stays tracked.
#
# extracted_fdbs/     Same reasoning: the generator cannot run without them and
#                     they cannot be regenerated without the game install.
#
# templates/icons/    Placeholder art harvested by extract_ui_svgs.py, which
#                     also needs the game's extracted UI outside this repo.
#
# These three are game-derived data. That is fine for a private/local repo; if
# this ever goes public, they should be removed from history rather than merely
# ignored, since ignoring does not untrack what is already committed.
